require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def ccache_enabled?(podfile_properties)
  # Environment variable takes precedence
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']
  
  # Fall back to Podfile properties
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['RCT_NEW_ARCH_ENABLED'] ||= '0' if podfile_properties['newArchEnabled'] == 'false'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'

prepare_react_native_project!

target 'Nuvio' do
  use_expo_modules!(exclude: ['expo-libvlc-player', 'expo-live-activity'])

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'npx',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  # KSPlayer dependencies
  # Use the local checkout so we can patch subtitle rendering (and other behaviors) without forking.
  pod 'KSPlayer', :path => '../KSPlayer'
  pod 'DisplayCriteria', :path => '../KSPlayer', :modular_headers => true
  pod 'FFmpegKit', :git => 'https://github.com/kingslay/FFmpegKit.git', :branch => 'main', :modular_headers => true
  pod 'Libass', :git => 'https://github.com/kingslay/FFmpegKit.git', :branch => 'main'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => true,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )

    # Exclude iOS-only pods from Mac Catalyst builds.
    # These pods use frameworks/APIs unavailable on Catalyst (ActivityKit, Google Cast, etc.).
    # We must both (a) prevent their compilation and (b) strip them from the main target's
    # linker flags, otherwise we trade compile errors for link errors.
    ios_only_pods = [
      'google-cast-sdk',
      'google-cast-sdk-GoogleCast',
      'react-native-google-cast',
    ]

    # (a) Prevent excluded pods from compiling any source on Catalyst.
    # We use EXCLUDED_SOURCE_FILE_NAMES rather than EXCLUDED_ARCHS because the latter
    # produces no .a file at all, which causes downstream build phases (e.g.
    # ExtractAppIntentsMetadata) to fail looking for the missing binary.
    # EXCLUDED_SOURCE_FILE_NAMES lets the target "build" an empty static library that
    # satisfies all build phase and linker expectations.
    installer.pods_project.targets.each do |target|
      if ios_only_pods.include?(target.name)
        target.build_configurations.each do |config|
          xcconfig_ref = config.base_configuration_reference
          next unless xcconfig_ref
          xcconfig_path = xcconfig_ref.real_path
          next unless File.exist?(xcconfig_path)
          xcconfig = File.read(xcconfig_path)
          unless xcconfig.include?('EXCLUDED_SOURCE_FILE_NAMES[sdk=macosx*]')
            xcconfig += "\nEXCLUDED_SOURCE_FILE_NAMES[sdk=macosx*] = *.swift *.m *.mm *.c *.cpp *.cc\n"
            File.write(xcconfig_path, xcconfig)
          end
        end
      end
    end

    # (b) Strip excluded pods from the main target's linker flags for Catalyst builds.
    # The Pods-Nuvio xcconfig has OTHER_LDFLAGS listing every pod library. We create a
    # conditional OTHER_LDFLAGS[sdk=macosx*] that omits the excluded ones.
    ios_only_lib_flags = ios_only_pods.map { |name| "-l\"#{name}\"" }
    # Also strip framework references for excluded pods and iOS-only system frameworks.
    ios_only_framework_flags = [
      '-framework "GoogleCast"',
      '-framework "CoreTelephony"',
      '-framework "MobileCoreServices"',
    ]
    installer.pods_project.targets.each do |target|
      next unless target.name == 'Pods-Nuvio'
      target.build_configurations.each do |config|
        xcconfig_ref = config.base_configuration_reference
        next unless xcconfig_ref
        xcconfig_path = xcconfig_ref.real_path
        next unless File.exist?(xcconfig_path)
        xcconfig = File.read(xcconfig_path)
        next if xcconfig.include?('OTHER_LDFLAGS[sdk=macosx*]')

        # Find the existing OTHER_LDFLAGS line and create a filtered version.
        # IMPORTANT: We strip $(inherited) from the conditional so it fully REPLACES
        # the base OTHER_LDFLAGS for the macosx SDK, rather than extending it.
        # Without this, $(inherited) pulls in the unfiltered base flags, re-adding
        # the very libraries we're trying to exclude.
        if xcconfig =~ /^OTHER_LDFLAGS\s*=\s*(.+)$/
          original_flags = $1
          filtered_flags = original_flags
          ios_only_lib_flags.each { |flag| filtered_flags = filtered_flags.gsub(flag, '') }
          ios_only_framework_flags.each { |flag| filtered_flags = filtered_flags.gsub(flag, '') }
          filtered_flags = filtered_flags.gsub('$(inherited)', '').gsub(/\s+/, ' ').strip
          xcconfig += "\nOTHER_LDFLAGS[sdk=macosx*] = #{filtered_flags}\n"
          File.write(xcconfig_path, xcconfig)
        end
      end
    end

    # Fix "bundle format is ambiguous" codesign error on Mac Catalyst.
    # React.framework uses a versioned macOS bundle layout that confuses codesign.
    # Adding --no-strict via OTHER_CODE_SIGN_FLAGS tells codesign to tolerate this.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'Pods-Nuvio'
      target.build_configurations.each do |config|
        xcconfig_ref = config.base_configuration_reference
        next unless xcconfig_ref
        xcconfig_path = xcconfig_ref.real_path
        next unless File.exist?(xcconfig_path)
        xcconfig = File.read(xcconfig_path)
        unless xcconfig.include?('OTHER_CODE_SIGN_FLAGS')
          xcconfig += "\nOTHER_CODE_SIGN_FLAGS[sdk=macosx*] = --no-strict\n"
          File.write(xcconfig_path, xcconfig)
        end
      end
    end

    # Patch libzvbi.xcframework to add a Mac Catalyst slice.
    # The upstream xcframework ships macos-arm64_x86_64 but no maccatalyst entry.
    # libzvbi is a pure C teletext library with no platform-specific deps, so
    # the macOS binary works identically under Catalyst. We copy it and update
    # the plist so Xcode can find a matching slice for the Catalyst destination.
    patch_libzvbi_for_catalyst(installer)
    patch_ksplayer_for_catalyst(installer)
  end
end

def patch_libzvbi_for_catalyst(installer)
  require 'fileutils'

  pods_root = installer.sandbox.root
  zvbi_fw = pods_root.join('FFmpegKit', 'Sources', 'libzvbi.xcframework')

  unless zvbi_fw.exist?
    Pod::UI.warn "[Catalyst] libzvbi.xcframework not found at #{zvbi_fw} -- skipping patch"
    return
  end

  catalyst_dir = zvbi_fw.join('ios-arm64_x86_64-maccatalyst')
  catalyst_framework = catalyst_dir.join('libzvbi.framework')
  if catalyst_framework.exist?
    Pod::UI.message "[Catalyst] libzvbi maccatalyst slice already exists -- skipping"
    return
  end

  macos_dir = zvbi_fw.join('macos-arm64_x86_64')
  unless macos_dir.exist?
    Pod::UI.warn "[Catalyst] libzvbi macos slice not found -- cannot create Catalyst slice"
    return
  end

  Pod::UI.message "[Catalyst] Patching libzvbi.xcframework: creating maccatalyst slice from macOS binary..."
  FileUtils.rm_rf(catalyst_dir.to_s) if catalyst_dir.exist?
  FileUtils.cp_r(macos_dir.to_s, catalyst_dir.to_s)

  # Update the xcframework Info.plist to register the new slice.
  plist_path = zvbi_fw.join('Info.plist')
  plist_content = File.read(plist_path)

  catalyst_entry = <<~PLIST
  \t\t<dict>
  \t\t\t<key>BinaryPath</key>
  \t\t\t<string>libzvbi.framework/libzvbi</string>
  \t\t\t<key>LibraryIdentifier</key>
  \t\t\t<string>ios-arm64_x86_64-maccatalyst</string>
  \t\t\t<key>LibraryPath</key>
  \t\t\t<string>libzvbi.framework</string>
  \t\t\t<key>SupportedArchitectures</key>
  \t\t\t<array>
  \t\t\t\t<string>arm64</string>
  \t\t\t\t<string>x86_64</string>
  \t\t\t</array>
  \t\t\t<key>SupportedPlatform</key>
  \t\t\t<string>ios</string>
  \t\t\t<key>SupportedPlatformVariant</key>
  \t\t\t<string>maccatalyst</string>
  \t\t</dict>
  PLIST

  # Insert before the closing </array> of AvailableLibraries.
  unless plist_content.include?('ios-arm64_x86_64-maccatalyst')
    plist_content.sub!(%r{(\s*</array>\s*<key>CFBundlePackageType</key>)}, "\n#{catalyst_entry}\\1")
    File.write(plist_path, plist_content)
    Pod::UI.message "[Catalyst] libzvbi.xcframework patched successfully"
  end
end

def patch_ksplayer_for_catalyst(installer)
  # KSPlayer's SeekView.swift has a #if canImport(AppKit) block that compiles
  # on Catalyst (where AppKit IS importable) but fails because:
  #   1. backgroundColor needs 'override' (UIView already declares it)
  #   2. 'layer' is non-optional on UIView, so 'if let layer' doesn't compile
  # We patch the source directly since KSPlayer is a local pod.
  seek_view = File.join(__dir__, '..', 'KSPlayer', 'Sources', 'KSPlayer', 'Video', 'SeekView.swift')

  unless File.exist?(seek_view)
    Pod::UI.warn "[Catalyst] SeekView.swift not found at #{seek_view} -- skipping KSPlayer patch"
    return
  end

  content = File.read(seek_view)
  changed = false

  # Fix 1: Add 'override' keyword to backgroundColor in the canImport(AppKit) block.
  if content.include?("    var backgroundColor: UIColor?") && !content.include?("override var backgroundColor")
    content.sub!("    var backgroundColor: UIColor?", "    override var backgroundColor: UIColor?")
    changed = true
  end

  # Fix 2: Remove 'if let layer,' -- layer is non-optional on UIView under Catalyst.
  if content.include?("if let layer, let cgColor = layer.backgroundColor")
    content.sub!("if let layer, let cgColor = layer.backgroundColor", "if let cgColor = layer.backgroundColor")
    changed = true
  end

  if changed
    File.write(seek_view, content)
    Pod::UI.message "[Catalyst] Patched KSPlayer SeekView.swift for Catalyst compatibility"
  else
    Pod::UI.message "[Catalyst] KSPlayer SeekView.swift already patched -- skipping"
  end
end
